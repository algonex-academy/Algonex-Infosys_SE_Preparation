##Problem 8: Count Even Numbers
def count_even(arr):
    count = 0
    for i in arr:
        if i % 2 == 0:
            count += 1
    return count

##Problem 9: Count Odd Numbers
def count_odd(arr):
    count = 0
    for i in arr:
        if i % 2 != 0:
            count += 1
    return count

###Problem 10: Count Positive and Negative Numbers
def count_numbers(arr):
    positive = 0
    negative = 0
    for i in arr:
        if i > 0:
            positive += 1
        elif i < 0:
            negative += 1
    return positive, negative

