Problem 1: Find Maximum Element
Method 1: Linear Traversal (Recommended)
def find_max(arr):
    maximum = arr[0]
    for num in arr:
        if num > maximum:             Time Complexity: O(n)
            maximum = num             Space Complexity: O(1)
    return maximum 

Method 2: Using Built-in Function
def find_max(arr):                      Time Complexity: O(n)
    return max(arr)                     Space Complexity: O(1)

Method 3: Sorting
def find_max(arr):
    arr.sort()                         Time Complexity: O(n log n)
    return arr[-1]                     Space Complexity: O(log n) auxiliary (Python sort)

Problem 2: Find Minimum Element
Input: [12,45,7,89,23]
Output: 7

#Method 1: Linear Traversal
def find_min(arr):
    minimum = arr[0]
    for i in arr:
        if i < minimum:         #Time: O(n)
            minimum = i         #Space: O(1)
    return minimum
arr=[12,45,7,89,23]
print(find_min(arr))

#Method 2
arr=[12,45,7,89,23]        #tIME:O(n)
print(min(arr))            #sPACE:O(!)

#Method 3
arr.sort()               #tIME: O(n log n)
print(arr[0])            #sPACE: O(log n)

#####Problem 3: Find Largest and Smallest Together
[12,45,7,89,23]
Largest = 89, Smallest = 7

#Method 1: Single Traversal (Optimal)
def largest_smallest(arr):
    maximum = arr[0]
    minimum = arr[0]
    for i in arr:
        if i > maximum:
            maximum = i
        if i < minimum:
            minimum = i
    return maximum, minimum


arr=[12,45,7,89,23]
print(largest_smallest(arr))

# Method2
print(max(arr))
print(min(arr))

Problem 4: Find Second Largest Element
[10,20,30,40,50]
Output: 40

Method 1: Two Variables (Optimal)
def second_largest(arr):
    first = second = float('-inf')
    for num in arr:
        if num > first:
            second = first
            first = num
        elif num > second and num != first:
            second = num
    return second

arr=[10,20,30,40,50]
print(second_largest(arr))

###Problem 5: Find Second Smallest Element
def second_smallest(arr):
    first = second = float('inf')
    for num in arr:
        if num < first:
            second = first
            first = num
        elif num < second and num != first:
            second = num
    return second

arr=[10,20,30,40,50]
print(second_smallest(arr))

